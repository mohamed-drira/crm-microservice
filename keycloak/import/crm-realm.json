{
  "realm": "crm",
  "enabled": true,
  "displayName": "CRM",
  "registrationAllowed": true,
  "sslRequired": "none",

  "roles": {
    "realm": [
      { "name": "ROLE_USER", "description": "Standard application user" },
      { "name": "ROLE_ADMIN", "description": "Application administrator" }
    ]
  },

  "clients": [
    {
      "clientId": "crm-frontend",
      "name": "CRM Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"]
    }
  ],

  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@example.com",
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "roles": {
        "realm": ["ROLE_USER", "ROLE_ADMIN"]
      }
    },
    {
      "username": "johndoe",
      "enabled": true,
      "emailVerified": true,
      "firstName": "John",
      "lastName": "Doe",
      "email": "john@example.com",
      "credentials": [
        { "type": "password", "value": "password123", "temporary": false }
      ],
      "roles": {
        "realm": ["ROLE_USER"]
      }
    }
  ]
}
